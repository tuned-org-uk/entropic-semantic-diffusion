# Copy to .env and fill in values before running experiments.
# uv will pick this up automatically via `uv run`.

# Optional: Weights & Biases experiment tracking
WANDB_PROJECT=esdm
WANDB_ENTITY=

# Optional: path to a pre-built L_F tensor (output of esdm-build)
ESDM_LF_PATH=data/L_F.pt

# Optional: path to a pre-built corpus embedding matrix V
ESDM_V_PATH=data/V.pt
